{
  "name": "post-quantum-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for NIST post-quantum cryptography (ML-KEM, ML-DSA, SLH-DSA, Falcon) built on @noble/post-quantum.",
  "private": true,
  "license": "MIT",
  "author": "VerisSuite",
  "type": "module",
  "bin": {
    "post-quantum-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run copy-wasm",
    "copy-wasm": "copyfiles -u 1 \"src/**/*.wasm\" dist/",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns threshold-signatures",
    "test:threshold": "node --experimental-vm-modules node_modules/jest/bin/jest.js threshold-signatures",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns threshold-signatures --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@noble/ciphers": "^1.2.0",
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@noble/post-quantum": "^0.6.0",
    "commander": "^11.1.0",
    "node-cache": "^5.1.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "post-quantum",
    "cryptography",
    "quantum-safe",
    "pqc",
    "kyber",
    "ml-kem",
    "dilithium",
    "ml-dsa",
    "sphincs",
    "slh-dsa",
    "falcon",
    "fips-203",
    "fips-204",
    "fips-205",
    "nist"
  ]
}
